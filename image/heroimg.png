<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600" role="img" aria-label="Packaging products: cardboard box, paper bags, food containers and kraft paper roll" xmlns:c2pa="http://c2pa.org/manifest">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#F5F9FA"/>
      <stop offset="1" stop-color="#D7E7E9"/>
    </linearGradient>
    <linearGradient id="floor" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#C6D6D9"/>
      <stop offset="1" stop-color="#EBF1F2"/>
    </linearGradient>
    <linearGradient id="kraftFront" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#DDB27C"/>
      <stop offset="1" stop-color="#C29360"/>
    </linearGradient>
    <linearGradient id="kraftTop" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#EBCD9F"/>
      <stop offset="1" stop-color="#DDB98A"/>
    </linearGradient>
    <linearGradient id="kraftSide" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#B58248"/>
      <stop offset="1" stop-color="#966637"/>
    </linearGradient>
    <linearGradient id="tealFront" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0A98A7"/>
      <stop offset="1" stop-color="#076F7A"/>
    </linearGradient>
    <linearGradient id="roll" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#E2BC8A"/>
      <stop offset="0.5" stop-color="#CFA36B"/>
      <stop offset="1" stop-color="#B58248"/>
    </linearGradient>
    <filter id="soft" x="-30%" y="-100%" width="160%" height="300%">
      <feGaussianBlur stdDeviation="7"/>
    </filter>
  </defs>

  <!-- Background -->
  <rect width="800" height="600" fill="url(#bg)"/>
  <circle cx="400" cy="320" r="270" fill="#FFFFFF" opacity="0.42"/>
  <circle cx="400" cy="320" r="318" fill="none" stroke="#AFC0C4" stroke-width="2" opacity="0.55"/>
  <rect y="432" width="800" height="168" fill="url(#floor)"/>

  <!-- Sparkles -->
  <g fill="#FFFFFF" opacity="0.9">
    <circle cx="110" cy="130" r="5"/>
    <circle cx="700" cy="110" r="7"/>
    <circle cx="660" cy="170" r="3"/>
    <circle cx="150" cy="200" r="3"/>
    <circle cx="90" cy="320" r="4"/>
    <circle cx="730" cy="300" r="4"/>
  </g>

  <!-- Soft shadows -->
  <g fill="#2E4A4F" opacity="0.22" filter="url(#soft)">
    <ellipse cx="262" cy="446" rx="150" ry="11"/>
    <ellipse cx="505" cy="440" rx="95" ry="10"/>
    <ellipse cx="628" cy="430" rx="85" ry="9"/>
    <ellipse cx="395" cy="514" rx="110" ry="10"/>
    <ellipse cx="128" cy="510" rx="90" ry="9"/>
  </g>

  <!-- Teal paper bag (back right) -->
  <g>
    <path d="M600 216 C600 166 642 166 642 216" fill="none" stroke="#05636B" stroke-width="4" stroke-linecap="round"/>
    <rect x="565" y="212" width="102" height="214" fill="url(#tealFront)"/>
    <polygon points="667,212 695,227 695,426 667,426" fill="#05636B"/>
    <rect x="565" y="212" width="102" height="18" fill="#2BB1BF"/>
    <rect x="565" y="408" width="102" height="18" fill="#05636B" opacity="0.25"/>
    <!-- logo -->
    <polygon points="616,292 639,304 639,331 616,343 593,331 593,304" fill="#FFFFFF"/>
    <polygon points="616,304 628,311 616,318 604,311" fill="#087F8C"/>
    <rect x="614" y="320" width="4" height="14" fill="#087F8C"/>
    <rect x="590" y="362" width="52" height="4" rx="2" fill="#FFFFFF" opacity="0.85"/>
    <rect x="600" y="372" width="32" height="3" rx="1.5" fill="#FFFFFF" opacity="0.5"/>
  </g>

  <!-- Large cardboard box (left) -->
  <g>
    <polygon points="150,285 190,245 375,245 335,285" fill="url(#kraftTop)"/>
    <rect x="150" y="285" width="185" height="155" fill="url(#kraftFront)"/>
    <polygon points="335,285 375,245 375,400 335,440" fill="url(#kraftSide)"/>
    <rect x="150" y="285" width="185" height="3" fill="#F2D9B0" opacity="0.7"/>
    <!-- grey tape -->
    <polygon points="228,285 268,245 292,245 252,285" fill="#D9DFE1"/>
    <rect x="228" y="285" width="24" height="64" fill="#D9DFE1"/>
    <rect x="228" y="345" width="24" height="4" fill="#B9C3C6"/>
    <!-- label -->
    <rect x="258" y="372" width="60" height="44" rx="4" fill="#F7F9F9"/>
    <rect x="258" y="372" width="60" height="10" rx="4" fill="#087F8C"/>
    <rect x="266" y="391" width="40" height="4" fill="#9FB0B4"/>
    <rect x="266" y="400" width="28" height="3" fill="#C9D3D5"/>
    <rect x="266" y="407" width="34" height="3" fill="#C9D3D5"/>
    <!-- arrows -->
    <path d="M176 380 l12 -16 l12 16 h-7 v22 h-10 v-22 z" fill="#8A5A2E" opacity="0.55"/>
  </g>

  <!-- Kraft paper bag (front right) -->
  <g>
    <path d="M470 242 C470 190 522 190 522 242" fill="none" stroke="#8A6236" stroke-width="4" stroke-linecap="round"/>
    <rect x="435" y="238" width="117" height="202" fill="url(#kraftFront)"/>
    <polygon points="552,238 583,252 583,440 552,440" fill="url(#kraftSide)"/>
    <rect x="435" y="238" width="117" height="20" fill="#EBCD9F"/>
    <line x1="494" y1="258" x2="494" y2="440" stroke="#B58248" stroke-width="2" opacity="0.45"/>
    <!-- label -->
    <rect x="455" y="330" width="78" height="46" rx="5" fill="#F7F9F9"/>
    <polygon points="494,338 508,346 508,362 494,370 480,362 480,346" fill="#087F8C"/>
    <polygon points="494,346 501,350 494,354 487,350" fill="#FFFFFF"/>
  </g>

  <!-- Food container stack, light grey (front center) -->
  <g>
    <rect x="310" y="480" width="170" height="30" rx="13" fill="#E3E8E9" stroke="#BCC6C9" stroke-width="2"/>
    <rect x="316" y="454" width="158" height="30" rx="13" fill="#EAEEEF" stroke="#BCC6C9" stroke-width="2"/>
    <rect x="322" y="428" width="146" height="30" rx="13" fill="#F4F6F7" stroke="#BCC6C9" stroke-width="2"/>
    <rect x="336" y="433" width="118" height="9" rx="4.5" fill="#FFFFFF"/>
    <rect x="342" y="487" width="106" height="4" rx="2" fill="#CDD5D7"/>
  </g>

  <!-- Kraft paper roll (front left) -->
  <g>
    <rect x="62" y="448" width="132" height="64" fill="url(#roll)"/>
    <ellipse cx="194" cy="480" rx="14" ry="32" fill="#A87638"/>
    <ellipse cx="62" cy="480" rx="14" ry="32" fill="#EBCD9F"/>
    <ellipse cx="62" cy="480" rx="8" ry="19" fill="#C9A06C"/>
    <ellipse cx="62" cy="480" rx="3" ry="7" fill="#7A532B"/>
    <rect x="120" y="448" width="10" height="64" fill="#087F8C" opacity="0.95"/>
  </g>

  <!-- Eco leaves -->
  <g>
    <path d="M700 440 C690 420 704 402 724 398 C728 418 718 436 700 440 Z" fill="#4FA79F"/>
    <path d="M700 440 C712 428 718 416 724 398" fill="none" stroke="#2F7F78" stroke-width="2"/>
    <path d="M700 440 C682 434 676 416 684 402 C700 408 706 424 700 440 Z" fill="#86C7BF"/>
  </g>
<metadata><c2pa:manifest></c2pa:manifest></metadata></svg>
